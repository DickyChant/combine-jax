# Same GPU architecture as the cache producer; inputs are spooled from lxplus905.
universe = vanilla
executable = worker.sh
request_cpus = 8
request_memory = 12GB
request_disk = 8GB
request_gpus = 1
requirements = regexp("A100|H100", GPUs_DeviceName) && !regexp("MIG", GPUs_DeviceName) && regexp("A100-PCIE-40GB", GPUs_DeviceName)
+JobFlavour = "workday"
should_transfer_files = YES
when_to_transfer_output = ON_EXIT
transfer_input_files = payload.tar.gz,runtime_patch.tar,cache_input.tar.gz
transfer_output_files = results,cache_after.tar.gz
output = worker.$(ClusterId).out
error = worker.$(ClusterId).err
log = worker.$(ClusterId).log
queue 1
